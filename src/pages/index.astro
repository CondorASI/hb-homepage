---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Advies from '../components/Advies.astro';
import Aanpak from '../components/Aanpak.astro';
import Bewijs from '../components/Bewijs.astro';
import Assessments from '../components/Assessments.astro';
import VoorWie from '../components/VoorWie.astro';
import OverHB from '../components/OverHB.astro';
import Abonnement from '../components/Abonnement.astro';
import Inzichten from '../components/Inzichten.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="HB — Strategisch sparringpartner voor ondernemers | Den Haag"
  description="Strategisch advies voor MKB, familiebedrijven en not-for-profit bij groei, opvolging en leiderschap. Onderbouwd met assessments. Ruim 30 jaar ervaring, Den Haag."
>
  <Header />
  <main id="main">
    <Hero />
    <LogoStrip />
    <Advies />
    <Aanpak />
    <Bewijs />
    <Assessments />
    <VoorWie />
    <OverHB />
    <Abonnement />
    <Inzichten />
    <Contact />
  </main>
  <Footer />
</Base>
