---
---
<section id="top" class="bg-surface-warm" aria-labelledby="hero-title">
  <div class="container-hb grid gap-12 py-16 md:py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-16 lg:py-28">
    <div>
      <p class="eyebrow">Strategisch advies voor ondernemers</p>
      <h1 id="hero-title" class="mt-5">Sparringpartner voor ondernemers bij groei, opvolging en leiderschap</h1>
      <p class="mt-6 text-lg text-muted md:text-xl">
        Al ruim 30 jaar helpen wij directeuren van MKB-bedrijven, familiebedrijven en not-for-profitorganisaties met scherpe inzichten en concreet advies — onderbouwd met assessments, gericht op de komende twee jaar.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#contact" class="btn btn-primary">Plan een strategiegesprek</a>
        <a href="#aanpak" class="btn btn-secondary">Bekijk onze aanpak</a>
      </div>
      <p class="mt-6 text-sm font-medium text-muted">
        30+ jaar ervaring<span class="mx-2 text-accent-dark" aria-hidden="true">·</span>Den Haag<span class="mx-2 text-accent-dark" aria-hidden="true">·</span>MKB, familiebedrijven en not-for-profit
      </p>
    </div>

    <div class="mx-auto w-full max-w-md lg:max-w-none">
      <img
        src="images/hero.webp"
        srcset="images/hero.webp 640w, images/hero@2x.webp 1280w"
        sizes="(min-width: 1024px) 40vw, (min-width: 640px) 448px, calc(100vw - 48px)"
        width="640"
        height="800"
        alt="Twee mensen in gesprek op een bank tijdens een adviesgesprek"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full rounded-card object-cover"
      />
    </div>
  </div>
</section>
