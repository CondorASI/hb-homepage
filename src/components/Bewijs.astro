---
import SectionHeading from './SectionHeading.astro';

// PLACEHOLDER stats: '–' until the real numbers are supplied (see CONTENT-TODO.md)
const stats = [
  { value: '30+', label: 'jaar ervaring', placeholder: false },
  { value: '—', label: 'assessments afgenomen', placeholder: true },
  { value: '—', label: 'opvolgingstrajecten begeleid', placeholder: true },
  { value: '—', label: 'organisaties geholpen', placeholder: true },
];

// PLACEHOLDER: illustrative quotes, generic roles only (see CONTENT-TODO.md)
const quotes = [
  {
    text: 'HB heeft ons geholpen om de organisatie mee te laten groeien met het bedrijf. Geen dik rapport, maar een helder verhaal en een MT dat nu echt als team werkt.',
    role: 'Directeur-eigenaar, MKB-bedrijf',
  },
  {
    text: 'Ze snappen hoe een familiebedrijf werkt. De opvolging is bespreekbaar geworden, met respect voor iedereen aan tafel.',
    role: 'Tweede generatie, familiebedrijf',
  },
  {
    text: 'Scherp in de analyse, prettig in de omgang. De assessments gaven ons de feiten om een lastige benoeming met vertrouwen te doen.',
    role: 'Bestuurder, zorgorganisatie',
  },
];
---
<section class="section bg-surface" aria-labelledby="bewijs-title">
  <div class="container-hb">
    <SectionHeading eyebrow="Resultaat" id="bewijs-title" title="Wat het oplevert" />

    <dl class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
      {stats.map((s) => (
        <div class="card p-6 md:p-7">
          <dd class:list={['text-4xl font-bold tracking-[-0.02em] md:text-5xl', s.placeholder ? 'text-muted/50' : 'text-primary']}>
            {s.placeholder ? <span aria-label="nog in te vullen">—</span> : s.value}
          </dd>
          <dt class="mt-2 text-sm font-medium text-muted md:text-base">{s.label}</dt>
        </div>
      ))}
    </dl>

    <!-- PLACEHOLDER: replace with real reviews -->
    <ul class="mt-6 grid gap-4 lg:grid-cols-3 lg:gap-6" role="list">
      {quotes.map((q) => (
        <li class="card flex flex-col p-7 md:p-8">
          <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.5 5C4 5 2 7.2 2 10.2c0 2.7 1.8 4.6 4.2 4.6.3 0 .6 0 .9-.1-.6 1.9-2.1 3.3-4.1 3.9v2.3c4.6-.7 8-4.4 8-9.6C11 7.6 9.1 5 6.5 5Zm11 0C15 5 13 7.2 13 10.2c0 2.7 1.8 4.6 4.2 4.6.3 0 .6 0 .9-.1-.6 1.9-2.1 3.3-4.1 3.9v2.3c4.6-.7 8-4.4 8-9.6C22 7.6 20.1 5 17.5 5Z" />
          </svg>
          <blockquote class="mt-4 flex-1">
            <p class="text-ink">{q.text}</p>
          </blockquote>
          <p class="mt-5 text-sm font-semibold text-muted">{q.role}</p>
        </li>
      ))}
    </ul>

    <!-- PLACEHOLDER: replace with a real, approved client case -->
    <article class="card mt-6 grid overflow-hidden lg:grid-cols-2" aria-labelledby="case-title">
      <img
        src="images/case.webp"
        width="900"
        height="600"
        alt="Adviseur van HB in gesprek met twee klanten aan tafel"
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full object-cover lg:aspect-auto lg:h-full"
      />
      <div class="p-7 md:p-10 lg:self-center">
        <p class="eyebrow">Voorbeeldcase</p>
        <h3 id="case-title" class="mt-3">Opvolging in een familiebedrijf</h3>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-sm font-bold uppercase tracking-[0.08em] text-primary">Situatie</dt>
            <dd class="mt-1 text-muted">Een familiebedrijf in de maakindustrie (tweede generatie, ±80 medewerkers) wil de leiding binnen drie jaar overdragen. Twee kinderen werken in het bedrijf, de rolverdeling is onduidelijk en het MT wacht af.</dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-[0.08em] text-primary">Aanpak</dt>
            <dd class="mt-1 text-muted">Gesprekken met familie en MT, ontwikkelassessments voor de beoogde opvolgers en een gezamenlijke sessie over eigendom, leiderschap en verhoudingen. Daarna een concreet opvolgingsplan met tijdlijn.</dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-[0.08em] text-primary">Resultaat</dt>
            <dd class="mt-1 text-muted">Een heldere rolverdeling, een opvolger die met vertrouwen in de rol groeit en een MT dat weer vooruitkijkt. HB blijft als sparringpartner betrokken bij de uitvoering.</dd>
          </div>
        </dl>
      </div>
    </article>
  </div>
</section>
